#!/usr/bin/with-contenv bash

# Opt-in: only run the HTTP CONNECT proxy when HTTP_PORT is set,
# AND only in single-account proxy mode (pool/HAProxy handles HTTP
# fanout when ACCOUNT_COUNT>=2, and TUN mode has no proxy at all).
if [ -z "$HTTP_PORT" ] || [ "${ACCOUNT_COUNT:-1}" -ge 2 ] || [ "${MODE:-proxy}" = "tun" ]; then
    s6-svc -d .
    exit 0
fi

cmd=(/usr/local/bin/usque http-proxy
     -c /config/config.json
     -b 0.0.0.0
     -p "${HTTP_PORT}")

[ -n "$USERNAME" ] && cmd+=(-u "$USERNAME")
[ -n "$PASSWORD" ] && cmd+=(-w "$PASSWORD")

if [ -n "$DNS" ]; then
  IFS=',' read -ra _dns <<<"$DNS"
  for d in "${_dns[@]}"; do cmd+=(-d "$d"); done
fi

[ "$USE_HTTP2" = "true" ] && cmd+=(--http2)

exec s6-setuidgid abc "${cmd[@]}"
